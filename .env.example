# =====================================================================
#  POLYBATTLE | OFFICIAL — configuração do bot
#  Copie este arquivo para ".env" e preencha. NUNCA compartilhe o .env.
# =====================================================================

# --- Obrigatório -----------------------------------------------------
# Token do bot (Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=cole_o_token_aqui

# ID do servidor do PolyBattle (recomendado: os comandos aparecem na hora).
# Ative o Modo Desenvolvedor no Discord > clique direito no servidor > Copiar ID.
GUILD_ID=

# --- Arquivos ----------------------------------------------------------
DATABASE_PATH=data/polybattle.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Jogo ----------------------------------------------------------------
GAME_NAME=PolyBattle
# Links oficiais (use https://). Os vazios são omitidos dos painéis.
ROBLOX_GAME_URL=
ROBLOX_GROUP_URL=
WEBSITE_URL=
# Universe ID do jogo no Roblox (Creator Hub > experiência > Universe ID).
# Ativa /gamestatus e o aviso automático de atualização em #changelog.
ROBLOX_UNIVERSE_ID=
UPDATE_CHECK_MINUTES=10

# --- Verificação ----------------------------------------------------------
# Idade mínima da conta Discord para se verificar (0 desativa)
VERIFY_MIN_ACCOUNT_AGE_DAYS=3

# --- Punições automáticas por avisos (0 desativa cada etapa) ------------
WARN_TIMEOUT_THRESHOLD=3
WARN_TIMEOUT_MINUTES=60
WARN_KICK_THRESHOLD=5
WARN_BAN_THRESHOLD=0

# --- AutoMod ---------------------------------------------------------------
AUTOMOD_FLOOD_MESSAGES=6
AUTOMOD_FLOOD_SECONDS=5
AUTOMOD_DUPLICATE_MESSAGES=3
AUTOMOD_DUPLICATE_SECONDS=30
AUTOMOD_MAX_MENTIONS=5
AUTOMOD_TIMEOUT_MINUTES=10
AUTOMOD_MALICIOUS_LINK_TIMEOUT_MINUTES=1440

# --- Anti-raid -------------------------------------------------------------
RAID_JOIN_THRESHOLD=10
RAID_JOIN_SECONDS=30
RAID_MODE_MINUTES=15

# --- Tickets e cargos automáticos ------------------------------------------
MAX_OPEN_TICKETS_PER_USER=1
VETERAN_DAYS=30
